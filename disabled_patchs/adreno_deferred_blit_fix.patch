+// --- Adreno same-FBO blit workaround ---------------------------------------
+// The deferred pipeline copies data between color attachments of the *same*
+// FBO (Scene_framebuffer) via glBlitFramebuffer with identical source/dest
+// regions. Per the spec this is "undefined" when the read and draw framebuffer
+// is the same object; most drivers (desktop, Mali, PowerVR, ANGLE, Zink) just
+// do it, but the Qualcomm Adreno driver rejects it outright with
+// "source and destination can not be the same" (GL_INVALID_OPERATION) and the
+// copy silently does nothing. That is why backgrounds (color->emissive copy in
+// _begin) and the lit/shadowed result (composite->color copy in _finish) never
+// reach the visible buffer on Adreno while everything else works.
+//
+// Fix: read from a second FBO that aliases just the source texture, so
+// READ_FRAMEBUFFER != DRAW_FRAMEBUFFER. Semantics are otherwise identical to
+// the original blit (same textures, same regions, no shader/blend/depth state
+// touched).
+static GLuint Deferred_blit_read_fbo = 0;
+
+static void opengl_deferred_intra_fbo_copy(GLuint src_tex, GLenum dst_attachment)
+{
+	if (Deferred_blit_read_fbo == 0)
+		glGenFramebuffers(1, &Deferred_blit_read_fbo);
+
+	// Source comes from the alias FBO (different object than the scene FBO).
+	GL_state.BindFrameBuffer(Deferred_blit_read_fbo, GL_READ_FRAMEBUFFER);
+	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, src_tex, 0);
+	glReadBuffer(GL_COLOR_ATTACHMENT0);
+
+	// Destination stays on the scene FBO (still bound as draw).
+	glDrawBuffer(dst_attachment);
+
+	glBlitFramebuffer(0, 0, gr_screen.max_w, gr_screen.max_h,
+	                  0, 0, gr_screen.max_w, gr_screen.max_h,
+	                  GL_COLOR_BUFFER_BIT, GL_NEAREST);
+
+	// Restore read == draw == scene FBO so surrounding code is unaffected.
+	GL_state.BindFrameBuffer(Scene_framebuffer, GL_FRAMEBUFFER);
+}
+#endif // USE_OPENGL_ES
+
