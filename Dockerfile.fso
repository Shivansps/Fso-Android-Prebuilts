# Reproducible build environment for build_fso_android.sh
# ABIs: x86, x86_64, arm64-v8a, armeabi-v7a (debug + release each).
#
# This script downloads ONLY the Android NDK r29 (no Android SDK, no Java needed).
#
# IMPORTANT: linux/amd64 only — the NDK r29 zip the script fetches is linux-x86_64.
#
#   docker build  --platform=linux/amd64 -f Dockerfile.fso -t fso-android .
#   docker run --rm --platform=linux/amd64 -v "$PWD:/work" fso-android
#   (output: ./fso_android/jniLibs.tar.gz)

FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
	pkg-config \
	libudev-dev \
    cmake \
	libusb-1.0-0-dev \
    ninja-build \
    git \
    curl \
    ca-certificates \
    unzip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# --- Bake the Android NDK r29 into the image -------------------------------
# The script honors $ANDROID_NDK_HOME and skips its own download when it finds
# a valid toolchain here.
ENV ANDROID_NDK_HOME=/opt/android-ndk-r29
RUN curl -fL -o /tmp/ndk.zip \
      https://dl.google.com/android/repository/android-ndk-r29-linux.zip \
 && echo "87e2bb7e9be5d6a1c6cdf5ec40dd4e0c6d07c30b  /tmp/ndk.zip" | sha1sum -c - \
 && unzip -q /tmp/ndk.zip -d /opt \
 && rm /tmp/ndk.zip \
 && test -f "$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake"

WORKDIR /work

# Fallback copy for plain `docker run` without a bind mount; a bind mount of the
# project dir (recommended, see compose.fso.yaml) overrides this and lets the
# downloaded android-ndk-r29-linux.zip persist on the host between runs.
COPY build_fso_android.sh /work/build_fso_android.sh
# Bake the local patches too (so a plain `docker run` without a bind mount also
# has them). The folder must exist in the build context — keep it present (even
# empty, with a .gitkeep). With the compose bind mount, the host patchs/ is used.
COPY patchs/ /work/patchs/
RUN chmod +x /work/build_fso_android.sh

CMD ["sh", "/work/build_fso_android.sh"]
