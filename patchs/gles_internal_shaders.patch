+    float alphaThreshold;
+    uint clipEnabled;
+} _22;
+
+layout(std140) uniform matrixData
+{
+    mat4 modelViewMatrix;
+    mat4 projMatrix;
+} _36;
+
+out vec4 fragTexCoord;
+in vec4 vertTexCoord;
+out vec4 fragColor;
+in vec4 vertColor;
+in vec4 vertPosition;
+out float vClipDist;
+
+void main()
