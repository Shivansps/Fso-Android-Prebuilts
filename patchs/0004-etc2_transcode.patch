+					decode(src, rgba + ((size_t)i * pw + j) * 4, (int)(pw * 4));
+					src += block_bytes;
+				}
+			}
+
+			// R<->B
+			const size_t px_count = (size_t)pw * ph;
+			for (size_t p = 0; p < px_count; ++p) {
+				ubyte* px = rgba + p * 4;
+				const ubyte tmp = px[0];
+				px[0] = px[2];
+				px[2] = tmp;
