+void ffxmSafeReleasePipeline(FfxmInterface* backendInterface, FfxmPipelineState* pipeline, FfxmUInt32 effectContextId)
+{
+    FFXM_ASSERT(pipeline);
+    backendInterface->fpDestroyPipeline(backendInterface, pipeline, effectContextId);
+}
+
+void ffxmSafeReleaseCopyResource(FfxmInterface* backendInterface, FfxmResourceInternal resource)
+{
+    FfxmResourceInternal copyResource;
+    copyResource.internalIndex = resource.internalIndex + 1;
+    backendInterface->fpDestroyResource(backendInterface, copyResource);
+}
+
+void ffxmSafeReleaseResource(FfxmInterface* backendInterface, FfxmResourceInternal resource)
+{
+    backendInterface->fpDestroyResource(backendInterface, resource);
+}
