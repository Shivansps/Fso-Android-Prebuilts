+/// @defgroup Asserts Asserts
+/// Asserts used by FidelityFX SDK functions
+///
+/// @ingroup ffxmHost
+
+#ifdef _DEBUG
+#ifdef _WIN32
+
+#ifdef DISABLE_FFXM_DEBUG_BREAK
+#define FFXM_DEBUG_BREAK \
+    {                   \
+    }
+#else
+/// Macro to force the debugger to break at this point in the code.
+///
+/// @ingroup Asserts
+#define FFXM_DEBUG_BREAK __debugbreak();
+#endif
+#else
+#define FFXM_DEBUG_BREAK \
+    {                   \
+    }
+#endif
+#else
+// don't allow debug break in release builds.
+#define FFXM_DEBUG_BREAK
+#endif
+
+/// A typedef for the callback function for assert printing.
+///
+/// This can be used to re-route printing of assert messages from the FFX backend
+/// to another destination. For example instead of the default behaviour of printing
+/// the assert messages to the debugger's TTY the message can be re-routed to a
+/// MessageBox in a GUI application.
+///
+/// @param [in] message                 The message generated by the assert.
+///
+/// @ingroup Asserts
+typedef void (*FfxmAssertCallback)(const char* message);
+
+/// Function to report an assert.
+///
+/// @param [in] file                    The name of the file as a string.
+/// @param [in] line                    The index of the line in the file.
+/// @param [in] condition               The boolean condition that was tested.
+/// @param [in] msg                     The optional message to print.
+///
+/// @returns
+/// Always returns true.
+///
+/// @ingroup Asserts
+FFXM_API bool ffxmAssertReport(const char* file, int32_t line, const char* condition, const char* msg);
+
+/// Provides the ability to set a callback for assert messages.
+///
+/// @param [in] callback                The callback function that will receive assert messages.
+///
+/// @ingroup Asserts
+FFXM_API void ffxmAssertSetPrintingCallback(FfxmAssertCallback callback);
+
+#ifdef _DEBUG
+/// Standard assert macro.
+///
+/// @ingroup Asserts
+#define FFXM_ASSERT(condition)                                                      \
+    do                                                                             \
+    {                                                                              \
+        if (!(condition) && ffxmAssertReport(__FILE__, __LINE__, #condition, NULL)) \
+            FFXM_DEBUG_BREAK                                                        \
+    } while (0)
+
+/// Assert macro with message.
+///
+/// @ingroup Asserts
+#define FFXM_ASSERT_MESSAGE(condition, msg)                                        \
+    do                                                                            \
+    {                                                                             \
+        if (!(condition) && ffxmAssertReport(__FILE__, __LINE__, #condition, msg)) \
+            FFXM_DEBUG_BREAK                                                       \
+    } while (0)
+
+/// Assert macro that always fails.
+///
+/// @ingroup Asserts
+#define FFXM_ASSERT_FAIL(message)                            \
+    do                                                      \
+    {                                                       \
+        ffxmAssertReport(__FILE__, __LINE__, NULL, message); \
+        FFXM_DEBUG_BREAK                                     \
+    } while (0)
+#else
+// asserts disabled
+#define FFXM_ASSERT(condition)  \
+    do                         \
+    {                          \
+        FFXM_UNUSED(condition); \
+    } while (0)
+
+#define FFXM_ASSERT_MESSAGE(condition, message) \
+    do                                         \
+    {                                          \
+        FFXM_UNUSED(condition);                 \
+        FFXM_UNUSED(message);                   \
+    } while (0)
+
+#define FFXM_ASSERT_FAIL(message) \
+    do                           \
+    {                            \
+        FFXM_UNUSED(message);     \
+    } while (0)
+#endif  // #if _DEBUG
+
+/// Simple static assert.
+///
+/// @ingroup Asserts
+#define FFXM_STATIC_ASSERT(condition) static_assert(condition, #condition)
+
+#ifdef __cplusplus
+}
+#endif  // #ifdef __cplusplus
+
+} // namespace arm
