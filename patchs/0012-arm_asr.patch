+    pix = min(FfxFloat16x3(bothR.y, bothG.y, bothB.y), max(-FfxFloat16x3(bothR.x, bothG.x, bothB.x), aC * FFXM_BROADCAST_FLOAT16X3(ffxReciprocalHalf(aW))));
