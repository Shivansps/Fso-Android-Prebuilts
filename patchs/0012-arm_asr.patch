+/// @ingroup GPUCore
+FfxUInt16x2 ffxFloatToSortableIntegerHalf(FfxUInt16x2 x)
+{
+    return x ^ ((ffxBitShiftRightHalf(x, FFXM_BROADCAST_UINT16X2(15))) | FFXM_BROADCAST_UINT16X2(0x8000));
