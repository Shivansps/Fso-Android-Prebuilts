+
+#if defined(FSR2_BIND_CB_FSR2)
+    layout (set = 0, binding = FSR2_BIND_CB_FSR2 + SET_0_CB_START, std140) uniform cbFSR2_t
+    {
+		FfxInt32x2    iRenderSize;
+		FfxInt32x2    iMaxRenderSize;
