+
+        {   FFXM_FSR2_RESOURCE_IDENTIFIER_INTERNAL_DILATED_MOTION_VECTORS_1, L"FSR2_InternalDilatedVelocity1", FFXM_RESOURCE_TYPE_TEXTURE2D, (FfxmResourceUsage)(FFXM_RESOURCE_USAGE_RENDERTARGET),
