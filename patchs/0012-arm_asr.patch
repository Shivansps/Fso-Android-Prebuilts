+
+        case FFXM_FSR2_PASS_RECONSTRUCT_PREVIOUS_DEPTH:
+        {
+            FfxmShaderBlob blob = fsr2GetReconstructPreviousDepthPassPermutationBlobByIndex(permutationOptions, isWave64, is16bit);
