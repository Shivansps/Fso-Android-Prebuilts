+// Create a FfxmDevice from a VkDevice
+FfxmDevice ffxmGetDeviceVK(VkDeviceContext* vkDeviceContext)
+{
+    sVkDeviceContext = *vkDeviceContext;
+    const auto get = vkDeviceContext->vkInstanceProcAddr;
+    const auto instance = vkDeviceContext->vkInstance;
+    enumerateDeviceExtensions = reinterpret_cast<PFN_vkEnumerateDeviceExtensionProperties>(get(instance, "vkEnumerateDeviceExtensionProperties"));
+    getPhysicalDeviceMemoryProperties = reinterpret_cast<PFN_vkGetPhysicalDeviceMemoryProperties>(get(instance, "vkGetPhysicalDeviceMemoryProperties"));
+    getPhysicalDeviceProperties2 = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(get(instance, "vkGetPhysicalDeviceProperties2"));
+    getPhysicalDeviceFeatures2 = reinterpret_cast<PFN_vkGetPhysicalDeviceFeatures2>(get(instance, "vkGetPhysicalDeviceFeatures2"));
+    return reinterpret_cast<FfxmDevice>(&sVkDeviceContext);
+}
