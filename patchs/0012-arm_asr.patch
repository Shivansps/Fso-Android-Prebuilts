--- /dev/null
+++ b/lib/ffx/third_party/arm-asr/include/gpu/fsr2/ffxm_fsr2_accumulate.h
@@ -0,0 +1,396 @@
+// Copyright  © 2023 Advanced Micro Devices, Inc.
+// Copyright  © 2024-2025 Arm Limited.
