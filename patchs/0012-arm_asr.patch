+    case(FFXM_SURFACE_FORMAT_R16_SNORM):
+        return VK_FORMAT_R16_SNORM;
+    case(FFXM_SURFACE_FORMAT_R8_UNORM):
+        return VK_FORMAT_R8_UNORM;
+	case(FFXM_SURFACE_FORMAT_R8_SNORM):
